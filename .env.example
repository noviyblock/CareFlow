# Copy to .env (git-ignored) and `set -a; source .env; set +a` before running.
# DagsHub: Settings -> Tokens. Token for MLflow.
MLFLOW_TRACKING_USERNAME=noviyblock
MLFLOW_TRACKING_PASSWORD=
# DagsHub S3 (DVC remote): Remote -> S3 tab. Names match the existing .env.
S3_ACSESS_KEY_ID=
S3_SECRET_ACSESS_KEY=
# OpenAI-compatible API for large agents / judge (see configs/compute/hybrid.yaml)
CAREFLOW_API_BASE_URL=
CAREFLOW_API_KEY=
